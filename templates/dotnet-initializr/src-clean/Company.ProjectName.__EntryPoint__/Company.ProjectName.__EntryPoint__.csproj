<!--#if (IncludeWebApi || IncludeMinimalApi) -->
<Project Sdk="Microsoft.NET.Sdk.Web">
<!--#elseif (IncludeWorker) -->
<Project Sdk="Microsoft.NET.Sdk.Worker">
<!--#else -->
<Project Sdk="Microsoft.NET.Sdk">
<!--#endif -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
<!--#if (IncludeConsole) -->
    <OutputType>Exe</OutputType>
<!--#endif -->
  </PropertyGroup>

<!--#if (IncludeWebApi || IncludeMinimalApi) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
  </ItemGroup>
<!--#endif -->

<!--#if (IncludeConsole || IncludeWorker) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.*" />
  </ItemGroup>
<!--#endif -->

  <ItemGroup>
    <ProjectReference Include="../Company.ProjectName.Infrastructure/Company.ProjectName.Infrastructure.csproj" />
    <ProjectReference Include="../Company.ProjectName.Application/Company.ProjectName.Application.csproj" />
  </ItemGroup>

</Project>
