{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
//#if (IncludeAnyOrm)
  ,"ConnectionStrings": {
//#if (IncludePostgreSql)
    "DefaultConnection": "Host=localhost;Database=mydb;Username=postgres;Password=your_password"
//#elif (IncludeSqlServer)
    "DefaultConnection": "Server=localhost;Database=mydb;User Id=sa;Password=your_password;TrustServerCertificate=True"
//#elif (IncludeMySql)
    "DefaultConnection": "Server=localhost;Database=mydb;User=root;Password=your_password"
//#elif (IncludeSqlite)
    "DefaultConnection": "Data Source=app.db"
//#endif
  }
//#endif
