<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
<!--#if (IncludeWorker) -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.*" />
<!--#endif -->
  </ItemGroup>

<!--#if (IncludeEfCore) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="__EfCoreVersion__" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="__EfCoreVersion__" />
<!--#if (IncludePostgreSql) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="__NpgsqlEfVersion__" />
<!--#elif (IncludeSqlServer) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="__EfCoreVersion__" />
<!--#elif (IncludeMySql) -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="__PomeloVersion__" />
<!--#elif (IncludeSqlite) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="__EfCoreVersion__" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeDapper) -->
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.*" />
<!--#if (IncludePostgreSql) -->
    <PackageReference Include="Npgsql" Version="9.*" />
<!--#elif (IncludeSqlServer) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
<!--#elif (IncludeMySql) -->
    <PackageReference Include="MySqlConnector" Version="2.*" />
<!--#elif (IncludeSqlite) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="__EfCoreVersion__" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->

<!--#if (IncludeAnyAuth) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
<!--#endif -->

<!--#if (IncludeJwt || IncludeKeycloak) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="__EfCoreVersion__" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeAspNetIdentity) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="__EfCoreVersion__" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeCaching) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeResilience) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeOpenTelemetry) -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.*" />
<!--#if (IncludeWebProject) -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.*" />
<!--#endif -->
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeHangfire) -->
  <ItemGroup>
    <PackageReference Include="Hangfire" Version="1.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.*" />
<!--#if (IncludePostgreSql) -->
    <PackageReference Include="Hangfire.PostgreSql" Version="1.*" />
<!--#elif (IncludeSqlServer) -->
    <PackageReference Include="Hangfire.SqlServer" Version="1.*" />
<!--#elif (IncludeMySql) -->
    <PackageReference Include="Hangfire.MySqlStorage" Version="2.*" />
<!--#elif (IncludeSqlite) -->
    <PackageReference Include="Hangfire.Storage.SQLite" Version="0.*" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeQuartz) -->
  <ItemGroup>
    <PackageReference Include="Quartz" Version="3.*" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.*" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.*" />
  </ItemGroup>
<!--#endif -->

  <ItemGroup>
    <ProjectReference Include="../Company.ProjectName.Application/Company.ProjectName.Application.csproj" />
    <ProjectReference Include="../Company.ProjectName.Domain/Company.ProjectName.Domain.csproj" />
  </ItemGroup>

</Project>
