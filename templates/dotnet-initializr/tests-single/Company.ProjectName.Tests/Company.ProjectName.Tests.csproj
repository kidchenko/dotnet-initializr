<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
<!--#if (IncludeFluentAssertions) -->
    <PackageReference Include="FluentAssertions" Version="7.*" />
<!--#endif -->
<!--#if (IncludeNSubstitute) -->
    <PackageReference Include="NSubstitute" Version="5.*" />
<!--#endif -->
<!--#if (IncludeBogus) -->
    <PackageReference Include="Bogus" Version="35.*" />
<!--#endif -->
  </ItemGroup>

<!--#if (IncludeCleanArchitecture) -->
  <ItemGroup>
    <ProjectReference Include="../../src/Company.ProjectName.Application/Company.ProjectName.Application.csproj" />
  </ItemGroup>
<!--#else -->
  <ItemGroup>
    <ProjectReference Include="../../src/Company.ProjectName/Company.ProjectName.csproj" />
  </ItemGroup>
<!--#endif -->

</Project>
