<!--#if (IncludeWebApi || IncludeMinimalApi) -->
<Project Sdk="Microsoft.NET.Sdk.Web">
<!--#elseif (IncludeWorker) -->
<Project Sdk="Microsoft.NET.Sdk.Worker">
<!--#else -->
<Project Sdk="Microsoft.NET.Sdk">
<!--#endif -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
<!--#if (IncludeConsole) -->
    <OutputType>Exe</OutputType>
<!--#endif -->
  </PropertyGroup>

<!--#if ((IncludeScalar || IncludeSwaggerUI || IncludeRedoc) && !IncludeNet8) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="__EfCoreVersion__" />
  </ItemGroup>
<!--#endif -->

<!--#if (IncludeConsole || IncludeWorker) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.*" />
  </ItemGroup>
<!--#endif -->

<!--#if (IncludeEfCore) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="__EfCoreVersion__" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="__EfCoreVersion__" />
<!--#if (IncludePostgreSql) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="__NpgsqlEfVersion__" />
<!--#elif (IncludeSqlServer) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="__EfCoreVersion__" />
<!--#elif (IncludeMySql) -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="__PomeloVersion__" />
<!--#elif (IncludeSqlite) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="__EfCoreVersion__" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeDapper) -->
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.*" />
<!--#if (IncludePostgreSql) -->
    <PackageReference Include="Npgsql" Version="9.*" />
<!--#elif (IncludeSqlServer) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
<!--#elif (IncludeMySql) -->
    <PackageReference Include="MySqlConnector" Version="2.*" />
<!--#elif (IncludeSqlite) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="__EfCoreVersion__" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeJwt || IncludeKeycloak) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="__EfCoreVersion__" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeAspNetIdentity) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="__EfCoreVersion__" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeSwaggerUI && IncludeNet8) -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="__SwashbuckleVersion__" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeSwaggerUI && !IncludeNet8) -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="__SwashbuckleVersion__" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeSerilog) -->
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="__EfCoreVersion__" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeNLog && IncludeWebProject) -->
  <ItemGroup>
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.*" />
  </ItemGroup>
<!--#elif (IncludeNLog && !IncludeWebProject) -->
  <ItemGroup>
    <PackageReference Include="NLog.Extensions.Hosting" Version="6.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeValidation) -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.*" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeMapping) -->
  <ItemGroup>
    <PackageReference Include="Mapster" Version="7.*" />
    <PackageReference Include="Mapster.DependencyInjection" Version="1.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeCaching) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeResilience) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeOpenTelemetry) -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.*" />
<!--#if (IncludeWebProject) -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.*" />
<!--#endif -->
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeHangfire) -->
  <ItemGroup>
    <PackageReference Include="Hangfire" Version="1.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.*" />
<!--#if (IncludePostgreSql) -->
    <PackageReference Include="Hangfire.PostgreSql" Version="1.*" />
<!--#elif (IncludeSqlServer) -->
    <PackageReference Include="Hangfire.SqlServer" Version="1.*" />
<!--#elif (IncludeMySql) -->
    <PackageReference Include="Hangfire.MySqlStorage" Version="2.*" />
<!--#elif (IncludeSqlite) -->
    <PackageReference Include="Hangfire.Storage.SQLite" Version="0.*" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeQuartz) -->
  <ItemGroup>
    <PackageReference Include="Quartz" Version="3.*" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.*" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeScalar) -->
  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeRedoc && IncludeNet8) -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.ReDoc" Version="__SwashbuckleVersion__" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="__SwashbuckleVersion__" />
  </ItemGroup>
<!--#endif -->
<!--#if (IncludeRedoc && !IncludeNet8) -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.ReDoc" Version="__SwashbuckleVersion__" />
  </ItemGroup>
<!--#endif -->

</Project>
