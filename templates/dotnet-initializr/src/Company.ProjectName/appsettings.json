{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
//#if (IncludeAnyOrm)
  ,"ConnectionStrings": {
//#if (IncludePostgreSql)
    "DefaultConnection": "Host=localhost;Database=mydb;Username=postgres;Password=your_password"
//#elif (IncludeSqlServer)
    "DefaultConnection": "Server=localhost;Database=mydb;User Id=sa;Password=your_password;TrustServerCertificate=True"
//#elif (IncludeMySql)
    "DefaultConnection": "Server=localhost;Database=mydb;User=root;Password=your_password"
//#elif (IncludeSqlite)
    "DefaultConnection": "Data Source=app.db"
//#endif
//#if (IncludeCaching)
    ,"Redis": "localhost:6379"
//#endif
  }
//#endif
//#if (IncludeCaching && !IncludeAnyOrm)
  ,"ConnectionStrings": {
    "Redis": "localhost:6379"
  }
//#endif
//#if (IncludeJwt)
  ,"Authentication": {
    "Jwt": {
      "Issuer": "https://your-issuer.example.com",
      "Audience": "your-api-audience"
    }
  }
//#endif
//#if (IncludeKeycloak)
  ,"Authentication": {
    "Keycloak": {
      "Authority": "http://localhost:8080/realms/myrealm",
      "Audience": "your-api-audience"
    }
  }
//#endif
//#if (IncludeApiKey)
  ,"Authentication": {
    "ApiKey": "your-api-key-change-me"
  }
//#endif
//#if (IncludeSerilog)
  ,"Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/log-.txt", "rollingInterval": "Day" } }
    ],
    "Enrich": ["FromLogContext"]
  }
//#endif
//#if (IncludeNLog)
  ,"NLog": {
    "targets": {
      "logconsole": { "type": "Console" },
      "logfile": { "type": "File", "fileName": "logs/log-${shortdate}.txt" }
    },
    "rules": [
      { "logger": "Microsoft.*", "minLevel": "Warn", "writeTo": "logconsole,logfile" },
      { "logger": "System.*", "minLevel": "Warn", "writeTo": "logconsole,logfile" },
      { "logger": "*", "minLevel": "Info", "writeTo": "logconsole,logfile" }
    ]
  }
//#endif
}
