<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Initializr.Templates</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>Initializr Templates</Title>
    <Authors>kidchenko</Authors>
    <Description>dotnet new template for generating a minimal compilable .NET WebApi project.</Description>
    <PackageTags>dotnet-new;templates;webapi;initializr</PackageTags>

    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="dotnet-initializr\**\*"
             Exclude="dotnet-initializr\**\bin\**;dotnet-initializr\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
