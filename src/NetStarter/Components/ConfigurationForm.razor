@using NetStarter.Models

<div style="padding-top: 1rem;">

    <!-- Section 1: Project Info -->
    <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
        <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
            Project Info
        </h3>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Project Name</FieldLabel>
            <TextInput TValue="string"
                       @bind-Value="Config.ProjectName"
                       @bind-Value:after="NotifyChanged"
                       Placeholder="MyProject" />
        </Field>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Root Namespace</FieldLabel>
            <TextInput TValue="string"
                       @bind-Value="Config.Namespace"
                       @bind-Value:after="NotifyChanged"
                       Placeholder="MyProject" />
        </Field>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">.NET SDK Version</FieldLabel>
            <Select TValue="DotNetSdkVersion"
                    @bind-Value="Config.SdkVersion"
                    @bind-Value:after="NotifyChanged">
                <SelectItem Value="DotNetSdkVersion.Net8">.NET 8</SelectItem>
                <SelectItem Value="DotNetSdkVersion.Net9">.NET 9</SelectItem>
                <SelectItem Value="DotNetSdkVersion.Net10">.NET 10</SelectItem>
            </Select>
        </Field>
    </div>

    <!-- Section 2: Architecture -->
    <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
        <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
            Architecture
        </h3>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Project Type</FieldLabel>
            <RadioGroup TValue="ProjectType"
                        @bind-Value="Config.ProjectType"
                        @bind-Value:after="OnProjectTypeChanged"
                        Name="projectType">
                <Radio Value="ProjectType.WebApi">Web API</Radio>
                <Radio Value="ProjectType.MinimalApi">Minimal API</Radio>
                <Radio Value="ProjectType.Console">Console</Radio>
                <Radio Value="ProjectType.WorkerService">Worker Service</Radio>
            </RadioGroup>
        </Field>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Architecture Pattern</FieldLabel>
            <RadioGroup TValue="ArchitecturePattern"
                        @bind-Value="Config.Architecture"
                        @bind-Value:after="NotifyChanged"
                        Name="architecturePattern">
                <Radio Value="ArchitecturePattern.CleanArchitecture">Clean Architecture</Radio>
                <Radio Value="ArchitecturePattern.VerticalSlice">Vertical Slice</Radio>
                <Radio Value="ArchitecturePattern.SimpleLayered">Simple Layered</Radio>
            </RadioGroup>
        </Field>
    </div>

    <!-- Section 2b: Mapping -->
    <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
        <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
            Mapping
        </h3>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Mapping Library</FieldLabel>
            <RadioGroup TValue="MappingOption"
                        @bind-Value="Config.Mapping"
                        @bind-Value:after="NotifyChanged"
                        Name="mapping">
                <Radio Value="MappingOption.None">None</Radio>
                <Radio Value="MappingOption.Mapster">Mapster</Radio>
            </RadioGroup>
        </Field>
    </div>

    <!-- Section 3: Data -->
    <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
        <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
            Data
        </h3>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">ORM</FieldLabel>
            <RadioGroup TValue="OrmOption"
                        @bind-Value="Config.Orm"
                        @bind-Value:after="OnOrmChanged"
                        Name="orm">
                <Radio Value="OrmOption.None">None</Radio>
                <Radio Value="OrmOption.EfCore">EF Core</Radio>
                <Radio Value="OrmOption.Dapper">Dapper</Radio>
            </RadioGroup>
        </Field>

        @if (Config.Orm != OrmOption.None)
        {
            <Field>
                <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Database</FieldLabel>
                <RadioGroup TValue="DatabaseOption"
                            @bind-Value="SelectedDatabase"
                            @bind-Value:after="NotifyChanged"
                            Name="database">
                    <Radio Value="DatabaseOption.PostgreSql">PostgreSQL</Radio>
                    <Radio Value="DatabaseOption.SqlServer">SQL Server</Radio>
                    <Radio Value="DatabaseOption.MySql">MySQL</Radio>
                    <Radio Value="DatabaseOption.Sqlite">SQLite</Radio>
                </RadioGroup>
            </Field>
        }
    </div>

    <!-- Section 3b: Cache -->
    <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
        <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
            Cache
        </h3>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Caching</FieldLabel>
            <Check TValue="bool"
                   @bind-Value="Config.IncludeRedis"
                   @bind-Value:after="NotifyChanged">Redis</Check>
        </Field>
    </div>

    <!-- Section 4: Security -->
    <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
        <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
            Security
        </h3>

        @if (Config.ProjectType is ProjectType.WebApi or ProjectType.MinimalApi)
        {
            <Field>
                <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Authentication</FieldLabel>
                <RadioGroup TValue="AuthOption"
                            @bind-Value="Config.Auth"
                            @bind-Value:after="NotifyChanged"
                            Name="auth">
                    <Radio Value="AuthOption.None">None</Radio>
                    <Radio Value="AuthOption.Jwt">JWT</Radio>
                    @if (Config.Orm == OrmOption.EfCore)
                    {
                        <Radio Value="AuthOption.AspNetIdentity">ASP.NET Identity</Radio>
                    }
                    <Radio Value="AuthOption.Keycloak">Keycloak/OIDC</Radio>
                    <Radio Value="AuthOption.ApiKey">API Key</Radio>
                </RadioGroup>
            </Field>
        }
    </div>

    <!-- Section 4b: Validation -->
    <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
        <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
            Validation
        </h3>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Validation Library</FieldLabel>
            <Check TValue="bool"
                   @bind-Value="Config.IncludeFluentValidation"
                   @bind-Value:after="NotifyChanged">FluentValidation</Check>
        </Field>
    </div>

    <!-- Section 4c: Resilience -->
    @if (Config.ProjectType is ProjectType.WebApi or ProjectType.MinimalApi)
    {
        <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
            <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
                Resilience
            </h3>

            <Field>
                <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">HTTP Resilience</FieldLabel>
                <Check TValue="bool"
                       @bind-Value="Config.IncludeResilience"
                       @bind-Value:after="NotifyChanged">Polly / HTTP Resilience</Check>
            </Field>
        </div>
    }

    <!-- Section 4d: OpenAPI -->
    @if (Config.ProjectType is ProjectType.WebApi or ProjectType.MinimalApi)
    {
        <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
            <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
                OpenAPI
            </h3>

            <Field>
                <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">API Documentation</FieldLabel>
                <RadioGroup TValue="OpenApiUi"
                            @bind-Value="Config.ApiDocsUi"
                            @bind-Value:after="NotifyChanged"
                            Name="apiDocsUi">
                    <Radio Value="OpenApiUi.None">None</Radio>
                    <Radio Value="OpenApiUi.Scalar">Scalar</Radio>
                    <Radio Value="OpenApiUi.SwaggerUI">Swagger UI</Radio>
                    <Radio Value="OpenApiUi.Redoc">Redoc</Radio>
                </RadioGroup>
            </Field>
        </div>
    }

    <!-- Section 4e: Background Jobs -->
    @if (Config.ProjectType is ProjectType.WebApi or ProjectType.MinimalApi or ProjectType.WorkerService)
    {
        <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
            <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
                Background Jobs
            </h3>

            <Field>
                <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Background Jobs</FieldLabel>
                <RadioGroup TValue="BackgroundJobsOption"
                            @bind-Value="Config.BackgroundJobs"
                            @bind-Value:after="NotifyChanged"
                            Name="backgroundJobs">
                    <Radio Value="BackgroundJobsOption.None">None</Radio>
                    <Radio Value="BackgroundJobsOption.IHostedService">IHostedService</Radio>
                    @if (Config.Database.HasValue)
                    {
                        <Radio Value="BackgroundJobsOption.Hangfire">Hangfire</Radio>
                    }
                    <Radio Value="BackgroundJobsOption.Quartz">Quartz.NET</Radio>
                </RadioGroup>
                @if (Config.BackgroundJobs == BackgroundJobsOption.Hangfire
                     && Config.Database == DatabaseOption.Sqlite)
                {
                    <div style="margin-top: 0.5rem; padding: 0.5rem 0.75rem; border-radius: 0.25rem;
                                background-color: rgba(251, 191, 36, 0.12); border: 1px solid rgba(251, 191, 36, 0.4);
                                color: var(--text-secondary); font-size: 0.8125rem; line-height: 1.4;">
                        SQLite has no official Hangfire storage package. Jobs will use in-memory storage
                        and <strong>won't persist across restarts</strong>.
                    </div>
                }
            </Field>
        </div>
    }

    <!-- Section 5: Quality -->
    <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
        <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
            Quality
        </h3>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Logging</FieldLabel>
            <RadioGroup TValue="LoggingOption"
                        @bind-Value="Config.Logging"
                        @bind-Value:after="NotifyChanged"
                        Name="logging">
                <Radio Value="LoggingOption.None">None</Radio>
                <Radio Value="LoggingOption.Serilog">Serilog</Radio>
                <Radio Value="LoggingOption.NLog">NLog</Radio>
            </RadioGroup>
        </Field>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Observability</FieldLabel>
            <Check TValue="bool"
                   @bind-Value="Config.IncludeHealthChecks"
                   @bind-Value:after="NotifyChanged">Health Checks</Check>
            <Check TValue="bool"
                   @bind-Value="Config.IncludeOpenTelemetry"
                   @bind-Value:after="NotifyChanged">OpenTelemetry</Check>
        </Field>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Test Framework</FieldLabel>
            <RadioGroup TValue="TestFrameworkOption"
                        @bind-Value="Config.TestFramework"
                        @bind-Value:after="OnTestFrameworkChanged"
                        Name="testFramework">
                <Radio Value="TestFrameworkOption.None">None</Radio>
                <Radio Value="TestFrameworkOption.XUnit">xUnit</Radio>
                <Radio Value="TestFrameworkOption.NUnit">NUnit</Radio>
            </RadioGroup>
        </Field>

        @if (Config.HasTestFramework)
        {
            <Field>
                <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Assert Library</FieldLabel>
                <RadioGroup TValue="AssertLibraryOption"
                            @bind-Value="Config.AssertLibrary"
                            @bind-Value:after="NotifyChanged"
                            Name="assertLibrary">
                    <Radio Value="AssertLibraryOption.None">None</Radio>
                    <Radio Value="AssertLibraryOption.Shouldly">Shouldly</Radio>
                </RadioGroup>
            </Field>

            <Field>
                <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Integration Testing</FieldLabel>
                <Check TValue="bool"
                       @bind-Value="Config.IncludeTestcontainers"
                       @bind-Value:after="NotifyChanged">Testcontainers</Check>
            </Field>

            <Field>
                <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Mock Library</FieldLabel>
                <Check TValue="bool"
                       @bind-Value="Config.IncludeNSubstitute"
                       @bind-Value:after="NotifyChanged">NSubstitute</Check>
            </Field>
            <Field>
                <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Utility</FieldLabel>
                <Check TValue="bool"
                       @bind-Value="Config.IncludeBogus"
                       @bind-Value:after="NotifyChanged">Bogus</Check>
            </Field>
        }
    </div>

    <!-- Section 6: DevOps -->
    <div style="margin-bottom: 1.5rem; padding: 0 1.5rem;">
        <h3 style="color: var(--text-primary); font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);">
            DevOps
        </h3>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">Container Support</FieldLabel>
            <Check TValue="bool"
                   @bind-Value="Config.IncludeDockerfile"
                   @bind-Value:after="NotifyChanged">Dockerfile</Check>
            <Check TValue="bool"
                   @bind-Value="Config.IncludeDockerCompose"
                   @bind-Value:after="NotifyChanged">docker-compose</Check>
            <Check TValue="bool"
                   @bind-Value="Config.IncludeDotNetAspire"
                   @bind-Value:after="NotifyChanged">.NET Aspire</Check>
        </Field>

        <Field>
            <FieldLabel style="color: var(--text-secondary); font-size: 0.875rem;">CI/CD</FieldLabel>
            <Check TValue="bool"
                   @bind-Value="Config.IncludeGitHubActions"
                   @bind-Value:after="NotifyChanged">GitHub Actions</Check>
            <Check TValue="bool"
                   @bind-Value="Config.IncludeAzureDevOps"
                   @bind-Value:after="NotifyChanged">Azure DevOps</Check>
        </Field>
    </div>

</div>

@code {
    [Parameter] public ProjectConfiguration Config { get; set; } = new();
    [Parameter] public EventCallback OnConfigChanged { get; set; }

    // Computed property to bridge nullable DatabaseOption? with non-nullable Select binding
    private DatabaseOption SelectedDatabase
    {
        get => Config.Database ?? DatabaseOption.PostgreSql;
        set => Config.Database = value;
    }

    private async Task NotifyChanged()
    {
        await OnConfigChanged.InvokeAsync();
    }

    private async Task OnOrmChanged()
    {
        if (Config.Orm == OrmOption.None)
        {
            Config.Database = null;
        }
        else if (Config.Database is null)
        {
            Config.Database = DatabaseOption.PostgreSql;
        }

        if (Config.Auth == AuthOption.AspNetIdentity && Config.Orm != OrmOption.EfCore)
        {
            Config.Auth = AuthOption.None;
        }

        if (Config.BackgroundJobs == BackgroundJobsOption.Hangfire
            && Config.Database is null)
        {
            Config.BackgroundJobs = BackgroundJobsOption.None;
        }

        await NotifyChanged();
    }

    private async Task OnTestFrameworkChanged()
    {
        if (!Config.HasTestFramework)
        {
            Config.AssertLibrary = AssertLibraryOption.None;
            Config.IncludeTestcontainers = false;
            Config.IncludeNSubstitute = false;
            Config.IncludeBogus = false;
        }

        await NotifyChanged();
    }

    private async Task OnProjectTypeChanged()
    {
        if (Config.Auth != AuthOption.None && Config.ProjectType is not (ProjectType.WebApi or ProjectType.MinimalApi))
        {
            Config.Auth = AuthOption.None;
        }

        if (Config.IncludeResilience && Config.ProjectType is not (ProjectType.WebApi or ProjectType.MinimalApi))
        {
            Config.IncludeResilience = false;
        }

        if (Config.ApiDocsUi != OpenApiUi.None && Config.ProjectType is not (ProjectType.WebApi or ProjectType.MinimalApi))
        {
            Config.ApiDocsUi = OpenApiUi.None;
        }

        if (Config.BackgroundJobs != BackgroundJobsOption.None
            && Config.ProjectType == ProjectType.Console)
        {
            Config.BackgroundJobs = BackgroundJobsOption.None;
        }

        await NotifyChanged();
    }
}

<style>
    /* RESP-02: 44px minimum touch targets for mobile */
    @@media (max-width: 768px) {
        ::deep .b-radio,
        ::deep .b-check {
            min-height: 44px;
            display: flex;
            align-items: center;
        }

        ::deep .b-radio label,
        ::deep .b-check label {
            padding: 0.5rem 0;
            cursor: pointer;
        }

        /* Ensure Select dropdowns and text inputs have adequate touch target */
        ::deep .b-select select,
        ::deep .b-input input[type="text"] {
            min-height: 44px;
        }

        /* Global fallback for form controls using standard class names */
        ::deep .form-check,
        ::deep .form-radio,
        ::deep [class*="b-radio"],
        ::deep [class*="b-check"] {
            min-height: 44px;
            display: flex;
            align-items: center;
        }

        ::deep .form-select,
        ::deep .form-control,
        ::deep input[type="text"],
        ::deep select {
            min-height: 44px;
        }
    }
</style>
